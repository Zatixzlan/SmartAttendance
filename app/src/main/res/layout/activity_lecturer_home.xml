<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_btn_teal"
    tools:context=".LecturerHomeActivity">

    <!-- Profile icon (optional) -->
    <ImageView
        android:id="@+id/btnProfile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginTop="34dp"
        android:layout_marginEnd="18dp"
        android:padding="8dp"
        android:background="@drawable/bg_circle_white_20"
        android:src="@drawable/profile"
        android:contentDescription="profile"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Header -->
    <TextView
        android:id="@+id/tvWelcomeLect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="Lecturer Home"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0" />

    <TextView
        android:id="@+id/tvLectSub"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:paddingStart="22dp"
        android:paddingEnd="22dp"
        android:text="Create session QR and review attendance."
        android:textColor="@android:color/white"
        android:alpha="0.85"
        android:textSize="13sp"
        app:layout_constraintTop_toBottomOf="@id/tvWelcomeLect"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardLect"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:layout_marginTop="18dp"
        android:layout_marginBottom="18dp"
        app:cardCornerRadius="26dp"
        app:cardElevation="10dp"
        app:cardUseCompatPadding="true"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvLectSub"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Quick Actions"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#111111"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnCreateSession"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="14dp"
                android:text="Create Session (Generate QR)"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                app:cornerRadius="18dp"
                app:backgroundTint="@color/sa_teal_dark"
                android:textColor="@android:color/white"
                app:icon="@drawable/ic_qr"
                app:iconTint="@android:color/white"
                app:iconGravity="textStart"
                app:iconPadding="10dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnViewAttendance"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="12dp"
                android:text="View Sessions and Attendance"
                android:textAllCaps="false"
                android:textStyle="bold"
                android:textSize="14sp"
                app:cornerRadius="18dp"
                app:backgroundTint="#EEF7F7"
                android:textColor="@color/sa_teal_dark"
                app:strokeWidth="1dp"
                app:strokeColor="#2A0F7F7F"
                app:icon="@drawable/ic_history"
                app:iconGravity="textStart"
                app:iconPadding="10dp"/>


        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>
